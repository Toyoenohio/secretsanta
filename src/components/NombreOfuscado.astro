---
/**
 * Nombre ofuscado con ojo para revelar.
 * Muestra "**" en lugar del nombre; el botón del ojo lo muestra y lo vuelve a ocultar.
 * El comportamiento vive en el script global de este componente (delegación de eventos),
 * así funciona también para nombres inyectados después (por ejemplo en el papelito 3D).
 */
interface Props {
  nombre: string;
  clase?: string;
}
const { nombre, clase = "" } = Astro.props;
---

<span class={`nombre-ofuscado ${clase}`.trim()} data-nombre={nombre}>
  <span class="nombre-mask" aria-live="polite">**</span>
  <button
    type="button"
    class="ojo-toggle"
    aria-label="Mostrar el nombre"
    aria-pressed="false"
    title="Mostrar / ocultar el nombre"
  >
    <svg class="ojo-icon ojo-abierto" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18" aria-hidden="true">
      <path d="M2 12s3.6-6.5 10-6.5S22 12 22 12s-3.6 6.5-10 6.5S2 12 2 12Z" />
      <circle cx="12" cy="12" r="2.8" />
    </svg>
    <svg class="ojo-icon ojo-cerrado" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" width="18" height="18" aria-hidden="true">
      <path d="M3 4l18 16" />
      <path d="M10.6 6.1A9.6 9.6 0 0 1 12 6c6.4 0 10 6 10 6a17 17 0 0 1-3.2 3.9M6.6 8.2A16.7 16.7 0 0 0 2 12s3.6 6.5 10 6.5c1.2 0 2.3-.2 3.3-.6" />
    </svg>
  </button>
</span>

<style>
  .nombre-ofuscado {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    vertical-align: middle;
  }
  .nombre-mask {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.12em;
    line-height: 1;
  }
  .ojo-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, currentColor 25%, transparent);
    background: transparent;
    color: inherit;
    cursor: pointer;
    padding: 0;
    transition: background-color 0.15s ease, border-color 0.15s ease, transform 0.12s ease;
  }
  .ojo-toggle:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
    border-color: color-mix(in srgb, currentColor 45%, transparent);
  }
  .ojo-toggle:active { transform: scale(0.94); }
  .ojo-cerrado { display: none; }
  .nombre-ofuscado[data-mostrar='1'] .ojo-abierto { display: none; }
  .nombre-ofuscado[data-mostrar='1'] .ojo-cerrado { display: block; }
</style>

<script>
  (function () {
    if (window.__nombreOfuscadoInit) return;
    window.__nombreOfuscadoInit = true;

    document.addEventListener('click', (ev) => {
      const btn = (ev.target as HTMLElement)?.closest?.('.ojo-toggle');
      if (!btn) return;
      const cont = btn.closest('.nombre-ofuscado') as HTMLElement | null;
      if (!cont) return;
      ev.preventDefault();
      ev.stopPropagation();

      const mask = cont.querySelector('.nombre-mask');
      const nombre = cont.dataset.nombre || '';
      const visible = cont.dataset.mostrar === '1';

      if (visible) {
        cont.dataset.mostrar = '0';
        if (mask) mask.textContent = '**';
        btn.setAttribute('aria-pressed', 'false');
        btn.setAttribute('aria-label', 'Mostrar el nombre');
      } else {
        cont.dataset.mostrar = '1';
        if (mask) mask.textContent = nombre;
        btn.setAttribute('aria-pressed', 'true');
        btn.setAttribute('aria-label', 'Ocultar el nombre');
      }
    });
  })();
</script>
