---
/** Escena pixel: arbol, reno, santa y regalo sobre nieve. Todo SVG, sin imagenes. */
interface Props {
  etiqueta?: string;
}
const { etiqueta = 'Sorteos cerrados sin papelitos' } = Astro.props;
---

<div class="diorama">
  <div class="escena">
    <svg viewBox="0 0 160 100" xmlns="http://www.w3.org/2000/svg" role="img" aria-label="Santa, reno y arbol de navidad en pixel art">
      <!-- luna -->
      <rect fill="#F5BD62" height="14" width="14" x="132" y="8" />
      <rect fill="#F5BD62" height="2" width="8" x="136" y="6" />
      <rect fill="#F5BD62" height="2" width="8" x="136" y="22" />

      <!-- arbol -->
      <rect fill="#614000" height="14" width="6" x="12" y="58" />
      <polygon fill="#2B6955" points="15,20 2,42 28,42" />
      <polygon fill="#2B6955" points="15,34 0,56 30,56" />
      <polygon fill="#326F5B" points="15,46 -2,68 32,68" />
      <rect fill="#FFFFFF" height="2" width="4" x="13" y="20" />
      <rect fill="#FFFFFF" height="2" width="6" x="5" y="40" />
      <rect fill="#FFFFFF" height="2" width="5" x="22" y="40" />
      <rect fill="#FFFFFF" height="2" width="6" x="3" y="54" />
      <rect fill="#FFFFFF" height="2" width="7" x="23" y="54" />

      <!-- reno -->
      <rect fill="#9A6C17" height="14" width="22" x="44" y="52" />
      <rect fill="#9A6C17" height="14" width="12" x="58" y="40" />
      <rect fill="#A7303F" height="4" width="4" x="66" y="46" />
      <rect fill="#171D1B" height="2" width="2" x="62" y="42" />
      <rect fill="#614000" height="6" width="2" x="60" y="34" />
      <rect fill="#614000" height="2" width="6" x="58" y="32" />
      <rect fill="#614000" height="4" width="2" x="64" y="30" />
      <rect fill="#7C5400" height="12" width="3" x="46" y="66" />
      <rect fill="#7C5400" height="12" width="3" x="52" y="66" />
      <rect fill="#7C5400" height="12" width="3" x="61" y="66" />

      <!-- santa -->
      <rect fill="#171D1B" height="6" width="6" x="94" y="72" />
      <rect fill="#171D1B" height="6" width="6" x="104" y="72" />
      <rect fill="#A7303F" height="22" width="20" x="92" y="50" />
      <rect fill="#171D1B" height="4" width="20" x="92" y="58" />
      <rect fill="#F5BD62" height="6" width="6" x="99" y="57" />
      <rect fill="#FFFFFF" height="10" width="20" x="92" y="44" />
      <rect fill="#FFFFFF" height="4" width="12" x="96" y="54" />
      <rect fill="#FFDADA" height="8" width="16" x="94" y="38" />
      <rect fill="#171D1B" height="2" width="2" x="97" y="40" />
      <rect fill="#171D1B" height="2" width="2" x="105" y="40" />
      <rect fill="#C84856" height="2" width="2" x="101" y="42" />
      <rect fill="#FFFFFF" height="4" width="20" x="92" y="34" />
      <rect fill="#A7303F" height="8" width="16" x="94" y="26" />
      <rect fill="#FFFFFF" height="6" width="6" x="110" y="30" />

      <!-- regalo -->
      <rect fill="#2B6955" height="18" width="18" x="124" y="56" />
      <rect fill="#FFDADA" height="18" width="4" x="131" y="56" />
      <rect fill="#FFDADA" height="4" width="18" x="124" y="63" />
      <rect fill="#FFB3B5" height="4" width="10" x="128" y="52" />

      <!-- nieve -->
      <rect fill="#FFFFFF" height="22" width="160" x="0" y="78" />
      <rect fill="#F0F5F2" height="20" width="160" x="0" y="80" />
      <rect fill="#FFFFFF" height="4" width="28" x="10" y="76" />
      <rect fill="#FFFFFF" height="5" width="40" x="70" y="75" />
      <rect fill="#FFFFFF" height="4" width="30" x="120" y="76" />
    </svg>
  </div>

  <div class="pastilla">
    <span class="punto"></span>
    <span class="etiqueta">{etiqueta}</span>
  </div>
</div>

<style>
  .diorama {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 18px 16px 16px;
    background-color: #f0f5f2;
    border-radius: 16px;
    border: 1px solid rgba(23, 29, 27, .07);
    overflow: hidden;
  }

  /* copos de nieve decorativos en las esquinas */
  .diorama::before,
  .diorama::after {
    content: '';
    position: absolute;
    width: 6px;
    height: 6px;
    background-color: #ffffff;
    box-shadow: 22px 10px 0 #ffffff, 44px -4px 0 #ffffff, 66px 14px 0 #ffffff;
    top: 16px;
    opacity: .9;
  }
  .diorama::before { left: 18px; }
  .diorama::after  { right: 18px; transform: scaleX(-1); }

  .escena { width: 100%; max-width: 260px; display: flex; justify-content: center; }
  .escena svg {
    width: 100%;
    height: auto;
    image-rendering: pixelated;
    shape-rendering: crispEdges;
  }

  .pastilla {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px;
    background-color: #ffffff;
    border-radius: 9999px;
    box-shadow: 0 1px 2px rgba(23, 29, 27, .08);
  }

  .punto {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background-color: #2b6955;
    box-shadow: 0 0 0 0 rgba(43, 105, 85, .5);
    animation: latir 2.2s ease-out infinite;
  }

  .etiqueta {
    font-family: 'Space Grotesk', system-ui, sans-serif;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: .06em;
    text-transform: uppercase;
    color: #2b6955;
  }

  @keyframes latir {
    0%   { box-shadow: 0 0 0 0 rgba(43, 105, 85, .45); }
    70%  { box-shadow: 0 0 0 7px rgba(43, 105, 85, 0); }
    100% { box-shadow: 0 0 0 0 rgba(43, 105, 85, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .punto { animation: none; }
  }
</style>
