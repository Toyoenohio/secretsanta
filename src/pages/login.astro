---
import Layout from '../layouts/Layout.astro';
import { getCurrentUser } from '../lib/auth';

const user = await getCurrentUser(Astro.cookies);
const joinCode = Astro.url.searchParams.get('join') || '';

if (user) {
  return Astro.redirect(joinCode ? `/?join=${encodeURIComponent(joinCode)}` : '/');
}
---

<Layout title="Iniciar sesión">
  <div class="page-frame pt-10 pb-16">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
      <div class="lg:col-span-5 space-y-5">
        <h1 class="type-display reveal-item">
          Entra a tu cuenta.
        </h1>
        <p class="type-body reveal-item reveal-delay-1">
          Consulta tus salas de intercambio activas, actualiza tu wishlist con enlaces o escribe por el chat anónimo en vivo a tu amigo asignado.
        </p>

        {joinCode && (
          <div class="surface-panel space-y-1 reveal-item reveal-delay-2">
            <div class="type-small" style="color: var(--muted);">Código de invitación detectado</div>
            <div class="type-lead tabular">{joinCode}</div>
          </div>
        )}
      </div>

      <div class="lg:col-span-7">
        <div class="surface-panel max-w-xl space-y-6 reveal-item reveal-delay-1">
          <div class="space-y-1">
            <h2 class="type-lead">Credenciales de acceso</h2>
            <p class="type-small" style="color: var(--muted);">
              Ingresa el correo electrónico y la contraseña con los que te registraste.
            </p>
          </div>

          <div
            id="login-error"
            class="hidden p-3.5 rounded-[8px] type-small"
            style="background-color: var(--danger-bg); color: var(--danger-ink);"
          ></div>

          <div
            id="login-ok"
            class="hidden p-3.5 rounded-[8px] type-small"
            style="background-color: var(--ok-bg, #10331f); color: var(--ok-ink, #b7e4c7);"
          >
            Contraseña actualizada. Entrá con la nueva.
          </div>

          <form id="login-form" class="space-y-4">
            <input type="hidden" id="join-code" value={joinCode} />

            <div>
              <label for="login-email" class="block type-small mb-1.5">
                Correo electrónico
              </label>
              <input
                id="login-email"
                type="email"
                name="email"
                required
                placeholder="tu@correo.com"
              />
            </div>

            <div>
              <label for="login-password" class="block type-small mb-1.5">
                Contraseña
              </label>
    <div class="pw-wrap">
                      <input
                        id="login-password"
                        type="password"
                        name="password"
                        required
                        placeholder="Tu contraseña"
                      />
                      <button
                        type="button"
                        class="pw-toggle"
                        data-target="login-password"
                        aria-pressed="false"
                        aria-label="Mostrar contraseña"
                        title="Mostrar contraseña"
                      >
                        <svg class="pw-eye" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7z"/><circle cx="12" cy="12" r="3"/>
                        </svg>
                        <svg class="pw-eye-off" viewBox="0 0 24 24" aria-hidden="true">
                          <path d="M3 3l18 18"/><path d="M10.6 6.2A10.9 10.9 0 0 1 12 6c6.4 0 10 6 10 6a17.6 17.6 0 0 1-3.4 4.1"/>
                          <path d="M6.5 7.7A17.4 17.4 0 0 0 2 12s3.6 6 10 6a10.8 10.8 0 0 0 4.3-.9"/>
                          <path d="M9.9 9.9a3 3 0 0 0 4.2 4.2"/>
                        </svg>
                      </button>
                    </div>
            </div>

            <div class="text-right">
              <a
                href="/forgot"
                class="type-small"
                style="color: var(--muted); text-decoration: underline;"
              >
                ¿Olvidaste tu contraseña?
              </a>
            </div>

            <button type="submit" id="login-btn" class="btn-primary w-full">
              Entrar a mi cuenta
            </button>
          </form>

          <p class="type-small pt-2" style="color: var(--muted);">
            ¿Aún no tienes cuenta?{' '}
            <a
              href={joinCode ? `/register?join=${encodeURIComponent(joinCode)}` : '/register'}
              style="color: var(--ink); font-weight: 600; text-decoration: underline;"
            >
              Regístrate y completa tus datos aquí
            </a>
          </p>
        </div>
      </div>
    </div>
  </div>

  <script is:inline>
    const form = document.getElementById('login-form');
    const errorBox = document.getElementById('login-error');
    const submitBtn = document.getElementById('login-btn');
    const joinCode = document.getElementById('join-code')?.value || '';

    if (new URLSearchParams(window.location.search).get('reset') === '1') {
      document.getElementById('login-ok')?.classList.remove('hidden');
    }

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!errorBox || !submitBtn) return;
      errorBox.classList.add('hidden');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Ingresando...';

      const formData = new FormData(form);
      const payload = {
        email: formData.get('email'),
        password: formData.get('password'),
      };

      try {
        const res = await fetch('/api/auth/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) {
          errorBox.textContent = data.error || 'Error al iniciar sesión.';
          errorBox.classList.remove('hidden');
          submitBtn.disabled = false;
          submitBtn.textContent = 'Entrar a mi cuenta';
          return;
        }

        if (joinCode) {
          window.location.href = `/?join=${encodeURIComponent(joinCode)}`;
        } else {
          window.location.href = data.redirect || '/';
        }
      } catch {
        errorBox.textContent = 'Error de conexión. Intenta nuevamente.';
        errorBox.classList.remove('hidden');
        submitBtn.disabled = false;
        submitBtn.textContent = 'Entrar a mi cuenta';
      }
    });
  </script>
</Layout>
