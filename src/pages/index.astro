            </p>
          </div>

          <div class="lg:col-span-6 reveal-item reveal-delay-2">
            <div data-ui class="p-6 sm:p-8 max-w-[460px] mx-auto space-y-5">
              <div class="type-lead">Comenzar en Secret Santa</div>

              <div class="grid grid-cols-2 gap-2 p-1 rounded-[6px]" style="background-color: var(--bg);">
                <button
                  type="button"
                  data-cta-mode="register"
                  class="cta-mode-btn py-2 px-3 rounded-[4px] type-small font-medium cursor-pointer"
                  style="background-color: var(--accent); color: var(--accent-ink);"
                >
                  Crear cuenta nueva
                </button>
                <button
                  type="button"
                  data-cta-mode="join"
                  class="cta-mode-btn py-2 px-3 rounded-[4px] type-small font-medium cursor-pointer"
                  style="background-color: transparent; color: var(--ink);"
                >
                  Tengo un código
                </button>
              </div>

              <form id="landing-cta-form" class="space-y-4" action="/register" method="GET">
                <div>
                  <label for="landing-cta-input" class="block type-small mb-1.5" id="landing-cta-label">
                    Código de sala (opcional si te invitaron)
                  </label>
                  <input
                    id="landing-cta-input"
                    type="text"
                    name="join"
                    value={joinCodeParam}
                    placeholder="Ej. NAVIDAD-4829"
                  />
                </div>
                <button type="submit" class="btn-primary w-full" id="landing-cta-submit">
                  Continuar al registro y perfil
                </button>
              </form>
            </div>
          </div>
        </div>
      </section>
    </div>
  ) : (
    <!-- AUTHENTICATED PARTICIPANT DASHBOARD -->
    <div class="page-frame pt-6 space-y-10">
      <section class="surface-panel flex flex-col md:flex-row md:items-center justify-between gap-6">
        <div class="flex items-center gap-4">
          <div class="monogram monogram-lg">
            {user.avatar.startsWith('http') ? (
              <img src={user.avatar} alt={user.name} width="56" height="56" />
            ) : (
              <span>{formatAvatarLabel(user.avatar, user.name)}</span>
            )}
          </div>
          <div class="space-y-1">
            <h1 class="type-h2">
              Hola, {user.nickname || user.name}
            </h1>
            <p class="type-body" style="color: var(--muted);">
              Administra tus salas de intercambio, únete con código o actualiza tu wishlist global.
            </p>
          </div>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          <a href="/wishlist" class="btn-secondary">
            Mi wishlist ({wishlistCount})
          </a>
          <a href="/profile" class="btn-primary">
            Mis datos y tallas
          </a>
        </div>
      </section>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <!-- Left column: Join by code + Create room -->
        <div class="lg:col-span-5 space-y-6">
          <section class="surface-panel space-y-4">
            <div class="space-y-1">
              <h2 class="type-lead">Unirse con código</h2>
              <p class="type-small" style="color: var(--muted);">
                Ingresa el código de invitación que te compartieron en tu grupo.
              </p>
            </div>

            <div
              id="join-error"
              class="hidden p-3.5 rounded-[8px] type-small"
              style="background-color: var(--danger-bg); color: var(--danger-ink);"
            ></div>

            <form id="join-room-form" class="space-y-3">
              <div>
                <label for="join-code-input" class="block type-small mb-1.5">
                  Código de la sala
                </label>
                <input
                  type="text"
                  name="code"
                  id="join-code-input"
                  required
                  value={joinCodeParam}
                  placeholder="Ej. NAVIDAD-4829"
                  class="uppercase tabular font-medium"
                />
              </div>
              <button type="submit" id="join-room-btn" class="btn-primary w-full">
                Entrar a la sala
              </button>
            </form>
          </section>

          <section class="surface-panel space-y-4">
            <div class="space-y-1">
              <h2 class="type-lead">Crear nueva sala</h2>
              <p class="type-small" style="color: var(--muted);">
                Organiza un nuevo sorteo cerrado de amigo secreto y genera su código.
              </p>
            </div>

            <div
              id="create-error"
              class="hidden p-3.5 rounded-[8px] type-small"
              style="background-color: var(--danger-bg); color: var(--danger-ink);"
            ></div>

            <form id="create-room-form" class="space-y-4">
              <div>
                <label for="room-name-input" class="block type-small mb-1.5">
                  Nombre de la sala o evento *
                </label>
                <input
                  id="room-name-input"
                  type="text"
                  name="name"
                  required
                  placeholder="Ej. Intercambio Familia 2026"
                />
              </div>

              <div>
                <label for="room-date-input" class="block type-small mb-1.5">
                  Fecha de entrega (opcional)
                </label>
                <input id="room-date-input" type="date" name="exchange_date" />
              </div>

              <div class="grid grid-cols-3 gap-3">
                <div>
                  <label for="budget-min-input" class="block type-small mb-1.5">
                    Mínimo
                  </label>
                  <input id="budget-min-input" type="number" step="0.01" name="budget_min" placeholder="15" />
                </div>
                <div>
                  <label for="budget-max-input" class="block type-small mb-1.5">
                    Máximo
                  </label>
                  <input id="budget-max-input" type="number" step="0.01" name="budget_max" placeholder="50" />
                </div>
                <div>
                  <label for="currency-select" class="block type-small mb-1.5">
                    Moneda
                  </label>
                  <select id="currency-select" name="currency">
                    <option value="USD">USD ($)</option>
                    <option value="EUR">EUR (€)</option>
                    <option value="COP">COP ($)</option>
                    <option value="MXN">MXN ($)</option>
                    <option value="CLP">CLP ($)</option>
                    <option value="ARS">ARS ($)</option>
                    <option value="PEN">PEN (S/)</option>
                  </select>
                </div>
              </div>

              <div>
                <label for="room-desc-input" class="block type-small mb-1.5">
                  Reglas o notas para el grupo
                </label>
                <textarea
                  id="room-desc-input"
                  name="description"
                  rows="2"
                  placeholder="Ej. Entrega en la cena del 24 de diciembre. Completen su wishlist."
                ></textarea>
              </div>

              <button type="submit" id="create-room-btn" class="btn-primary w-full">
                Crear sala y generar código
              </button>
            </form>
          </section>
        </div>

        <!-- Right column: My rooms list -->
        <div class="lg:col-span-7 space-y-5">
          <div class="flex flex-wrap items-center justify-between gap-3">
            <h2 class="type-lead">Mis salas registradas ({myRooms.length})</h2>
            <div class="flex flex-wrap items-center gap-2">
              <button
                type="button"
                class="room-filter-tab status-pill status-pill-accent cursor-pointer border-0"
                data-filter="all"
              >
                Todas ({myRooms.length})
              </button>
              <button
                type="button"
                class="room-filter-tab status-pill cursor-pointer border-0"
                data-filter="open"
              >
                En registro ({openRoomsCount})
              </button>
              <button
                type="button"
                class="room-filter-tab status-pill cursor-pointer border-0"
                data-filter="drawn"
              >
                Sorteo activo ({drawnRoomsCount})
              </button>
            </div>
          </div>

          {myRooms.length === 0 ? (
            <div class="surface-panel py-12 text-center space-y-3">
              <h3 class="type-lead">Aún no participas en ninguna sala</h3>
              <p class="type-body mx-auto" style="color: var(--muted);">
                Crea una sala nueva en el panel izquierdo o únete con el código de invitación de tu grupo.
              </p>
            </div>
          ) : (
            <div class="space-y-4" id="rooms-list">
              {myRooms.map((room) => {
                const isOrganizer = room.organizer_id === user.id;
                const isDrawn = room.status === 'drawn';
                const hasRevealed = Boolean(room.has_revealed);

                return (
                  <a
                    href={`/rooms/${room.code}`}
                    data-room-status={room.status}
                    class="room-card-item block surface-card space-y-4"
                  >
                    <div class="flex flex-wrap items-start justify-between gap-3">
                      <div class="space-y-1">
                        <div class="flex flex-wrap items-center gap-2">
                          <span class="type-lead">{room.name}</span>
                          {isOrganizer && (
                            <span class="status-pill status-pill-warning">Organizador</span>
                          )}
                        </div>
                        <div class="type-small tabular" style="color: var(--muted);">
                          Código #{room.code} · {room.member_count} participantes
                        </div>
                      </div>

                      <span class={`status-pill ${isDrawn ? 'status-pill-success' : 'status-pill-accent'}`}>
                        {isDrawn ? (hasRevealed ? 'Papelito abierto' : 'Elegir papelito') : 'Fase de registro'}
                      </span>
                    </div>

                    {room.description && (
                      <p class="type-small" style="color: var(--muted);">
                        {room.description}
                      </p>
                    )}

                    <div class="flex flex-wrap items-center justify-between gap-2 type-small tabular pt-1">
                      <span style="color: var(--muted);">
                        {(room.budget_min != null || room.budget_max != null)
                          ? `Presupuesto: ${room.budget_min ?? 0} a ${room.budget_max ?? 'libre'} ${room.currency}`
                          : 'Presupuesto libre'}
                      </span>
                      <span class="font-medium">
                        {isDrawn && hasRevealed && room.receiver_name
                          ? `Asignado: ${room.receiver_nickname || room.receiver_name}`
                          : 'Abrir sala'}
                      </span>
                    </div>
                  </a>
                );
              })}
            </div>
          )}
        </div>
      </div>
    </div>
  )}

  <script is:inline>
    // Landing interactive demo 1: Closed-cycle paper slips
    const demoParticipants = [
      {
        monogram: 'ML',
        name: 'María Fernanda López',
        sizes: 'Camisa M · Calzado 38 · Prefiere café en grano y lectura',
        wish: 'Cafetera prensa francesa de acero 600ml',
        urlNote: 'Incluye enlace de tienda de referencia · Prioridad alta · 32 USD',
      },
      {
        monogram: 'CR',
        name: 'Carlos Andrés Rivas',
        sizes: 'Camisa L · Calzado 42 · Aficionado a la fotografía y senderismo',
        wish: 'Correa tejida para cámara mirrorless',
        urlNote: 'Incluye enlace de tienda de referencia · Prioridad media · 28 USD',
      },
      {
        monogram: 'VP',
        name: 'Valentina Pérez',
        sizes: 'Camisa S · Calzado 37 · Le encantan las acuarelas y plantas',
        wish: 'Bitácora de papel algodón 300g prensado en frío',
        urlNote: 'Entrada de solo texto · Prioridad alta · 24 USD',
      },
      {
        monogram: 'DM',
        name: 'Diego Mendoza',
        sizes: 'Camisa M · Calzado 41 · Cocina italiana y juegos de mesa',
        wish: 'Piedra refractaria para hornear pizza en casa',
        urlNote: 'Incluye enlace de tienda de referencia · Prioridad media · 35 USD',
      },
    ];

    const slipBtns = document.querySelectorAll('.demo-slip-btn');
    const shuffleBtn = document.getElementById('demo-shuffle-btn');
    const friendMonogram = document.getElementById('demo-friend-monogram');
    const friendName = document.getElementById('demo-friend-name');
    const friendSizes = document.getElementById('demo-friend-sizes');
    const wishTitle = document.getElementById('demo-wish-title');
    const wishUrl = document.getElementById('demo-wish-url');
    const cyclePill = document.getElementById('demo-cycle-pill');
    let slipOffset = 0;

    function selectDemoSlip(idx) {
      const p = demoParticipants[(idx + slipOffset) % demoParticipants.length];
      if (!p || !friendName) return;
      friendMonogram.textContent = p.monogram;
      friendName.textContent = p.name;
      friendSizes.textContent = p.sizes;
      wishTitle.textContent = p.wish;
      wishUrl.textContent = p.urlNote;

      slipBtns.forEach((b, i) => {
        const statusEl = b.querySelector('.demo-slip-status');
        if (i === idx) {
          b.style.backgroundColor = 'var(--accent)';
          b.style.color = 'var(--accent-ink)';
          if (statusEl) statusEl.textContent = 'Abierto';
        } else {
          b.style.backgroundColor = 'var(--bg)';
          b.style.color = 'var(--ink)';
          if (statusEl) statusEl.textContent = 'Abrir sobre';
        }
      });
    }

    slipBtns.forEach((btn, idx) => {
      btn.addEventListener('click', () => selectDemoSlip(idx));
    });

    shuffleBtn?.addEventListener('click', () => {
      slipOffset = (slipOffset + 1) % demoParticipants.length;
      selectDemoSlip(0);
      if (cyclePill) {
        cyclePill.textContent = 'Nuevo ciclo 4/4 generado';
      }
    });

    // Landing interactive demo 2: How-it-works range slider
    const stagesData = [
      {
        clause: 'Primero, cada participante registra sus tallas, gustos y dirección de entrega.',
        desc: 'Al entrar a la sala, completas tu talla de camisa, pantalón y calzado junto con tus preferencias o alergias para que nadie adivine a ciegas.',
        uiTitle: 'Ficha de participante · Datos y tallas',
        badge: 'Etapa 1 de 4',
        rows: [
          ['Tallas registradas', 'Camisa M · Pantalón 32 · Calzado 41'],
          ['Gustos e intereses', 'Libros de diseño, cerámica, chocolate 70%'],
          ['Restricciones o alergias', 'Sin frutos secos ni fragancias fuertes'],
        ],
      },
      {
        clause: 'Segundo, armas tu wishlist personal con entradas de texto o enlaces URL.',
        desc: 'Puedes añadir ideas abiertas en texto o acompañarlas del link directo de la tienda, indicando nivel de prioridad y precio aproximado.',
        uiTitle: 'Mi wishlist global · 3 deseos activos',
        badge: 'Etapa 2 de 4',
        rows: [
          ['Prensa francesa acero inoxidable', 'Texto + Enlace URL · 32 USD'],
          ['Libro de arquitectura nórdica', 'Solo texto · 25 USD'],
          ['Lámpara de lectura cálida recargable', 'Texto + Enlace URL · 28 USD'],
        ],
      },
      {
        clause: 'Tercero, el organizador activa los papelitos con ciclo cerrado garantizado.',
        desc: 'El algoritmo calcula un ciclo completo respetando las exclusiones configuradas. Nadie se saca a sí mismo y nadie queda jamás sin regalo.',
        uiTitle: 'Mesa de sorteo · Ciclo cerrado verificado',
        badge: 'Etapa 3 de 4',
        rows: [
          ['Participantes en el ciclo', '8 de 8 emparejados sin repeticiones'],
          ['Exclusiones aplicadas', '2 reglas de pareja respetadas'],
          ['Estado de tu sobre', 'Sobre #3 abierto · Asignado desbloqueado'],
        ],
      },
      {
        clause: 'Cuarto, consultas la wishlist de tu amigo y chateas en vivo sin revelar quién eres.',
        desc: 'Marca qué regalo compraste para que no se repita en otras salas y escríbele por WebSocket en tiempo real bajo seudónimo.',
        uiTitle: 'Canal anónimo WebSocket · Sala activa',
        badge: 'Etapa 4 de 4',
        rows: [
          ['Tu identidad frente a tu asignado', 'Oculta bajo seudónimo Amigo Secreto'],
          ['Estado del regalo elegido', 'Reservado en secreto para esta sala'],
          ['Último mensaje en vivo', 'Recibido hace instantes sin recargar'],
        ],
      },
    ];

    const howRange = document.getElementById('how-range');
    const stageBtns = document.querySelectorAll('.stage-label-btn');
    const stageClause = document.getElementById('stage-clause');
    const stageDesc = document.getElementById('stage-desc');
    const stageUiTitle = document.getElementById('stage-ui-title');
    const stageUiBadge = document.getElementById('stage-ui-badge');
    const stageUiRows = document.getElementById('stage-ui-rows');

    function setStage(idx) {
      const s = stagesData[idx];
      if (!s || !stageClause) return;
      if (howRange) howRange.value = String(idx);
      stageClause.textContent = s.clause;
      stageDesc.textContent = s.desc;
      stageUiTitle.textContent = s.uiTitle;
      stageUiBadge.textContent = s.badge;
      if (stageUiRows) {
        stageUiRows.innerHTML = s.rows
          .map(
            (r) =>
              `<div class="ui-row"><span>${r[0]}</span><span class="font-medium">${r[1]}</span></div>`
          )
          .join('');
      }
      stageBtns.forEach((b, i) => {
        b.style.color = i === idx ? 'var(--ink)' : 'var(--muted)';
        b.style.fontWeight = i === idx ? '600' : '500';
      });
    }

    howRange?.addEventListener('input', (e) => {
      setStage(Number(e.target.value) || 0);
    });
    stageBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        setStage(Number(btn.getAttribute('data-stage-btn')) || 0);
      });
    });

    // Landing interactive demo 3: Fixed output controls
    const wishModeBtns = document.querySelectorAll('.wish-mode-btn');
    const liveUrlRow = document.getElementById('live-url-row');
    const liveModePill = document.getElementById('live-output-mode-pill');
    const liveWishHeading = document.getElementById('live-wish-heading');
    const liveWishSub = document.getElementById('live-wish-sub');

    wishModeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-wish-mode');
        if (mode === 'text') {
          if (liveUrlRow) liveUrlRow.style.display = 'none';
          if (liveModePill) liveModePill.textContent = 'Solo texto activo';
          if (liveWishHeading) liveWishHeading.textContent = ' Caja de café de especialidad en grano (tueste medio)';
          if (liveWishSub) liveWishSub.textContent = 'Cualquier origen colombiano o etíope · 20 a 30 USD';
        } else {
          if (liveUrlRow) liveUrlRow.style.display = 'flex';
          if (liveModePill) liveModePill.textContent = 'Texto + URL activo';
          if (liveWishHeading) liveWishHeading.textContent = 'Audífonos inalámbricos cancelación de ruido';
          if (liveWishSub) liveWishSub.textContent = 'Color negro mate · Presupuesto sugerido 45 USD';
        }
      });
    });

    const toggleReserveBtn = document.getElementById('toggle-reserve-demo');
    const liveReserveBadge = document.getElementById('live-reserve-badge');
    let demoReserved = false;
    toggleReserveBtn?.addEventListener('click', () => {
      demoReserved = !demoReserved;
      if (liveReserveBadge) {
        liveReserveBadge.textContent = demoReserved
          ? 'Reservado por ti (oculto al dueño)'
          : 'Disponible';
      }
    });

    const demoChatInput = document.getElementById('demo-chat-input');
    const demoChatSend = document.getElementById('demo-chat-send');
    const liveChatPreview = document.getElementById('live-chat-preview');
    demoChatSend?.addEventListener('click', () => {
      if (demoChatInput && demoChatInput.value.trim() && liveChatPreview) {
        liveChatPreview.textContent = `"${demoChatInput.value.trim()}"`;
      }
    });

    // Landing interactive demo 4: FAQ index
    const faqData = [
      {
        kicker: 'Garantía matemática del sorteo',
        body: 'El sorteo no se improvisa uno por uno al azar: calcula primero un ciclo cerrado completo (permutación sin puntos fijos) con todos los miembros inscritos en la sala. Así es imposible que la última persona se saque a sí misma o que alguien quede fuera.',
      },
      {
        kicker: 'Reglas de exclusión entre participantes',
        body: 'Antes de habilitar los sobres, el organizador puede indicar qué parejas o familiares no deben tocarse entre sí. Nuestro buscador de ciclos verifica al instante que siga existiendo un sorteo válido para todos.',
      },
      {
        kicker: 'Privacidad y reserva entre salas',
        body: 'Tu wishlist es global para tu cuenta, pero dentro de cada sala solo la persona que sacó tu papelito puede abrirla. Cuando tu amigo secreto marca un deseo como comprado, tú sigues viéndolo normal para no arruinar la sorpresa.',
      },
      {
        kicker: 'Mensajería anónima por WebSocket',
        body: 'Cada sala cuenta con dos canales separados: uno donde escribes bajo el seudónimo de Amigo Secreto a la persona que te tocó, y otro donde recibes mensajes de quien te regala a ti sin exponer su nombre ni su correo.',
      },
    ];

    const faqBtns = document.querySelectorAll('.faq-q-btn');
    const faqKicker = document.getElementById('faq-answer-kicker');
    const faqBody = document.getElementById('faq-answer-body');

    faqBtns.forEach((btn) => {
      const activate = () => {
        const idx = Number(btn.getAttribute('data-faq-idx')) || 0;
        const item = faqData[idx];
        if (!item || !faqBody) return;
        faqKicker.textContent = item.kicker;
        faqBody.textContent = item.body;
        faqBtns.forEach((b, i) => {
          const dot = b.querySelector('.faq-dot');
          if (i === idx) {
            b.style.backgroundColor = 'var(--surface)';
            b.style.color = 'var(--ink)';
            b.style.fontWeight = '600';
            if (dot) dot.style.backgroundColor = 'var(--accent)';
          } else {
            b.style.backgroundColor = 'transparent';
            b.style.color = 'var(--muted)';
            b.style.fontWeight = '400';
            if (dot) dot.style.backgroundColor = 'var(--muted)';
          }
        });
      };
      btn.addEventListener('click', activate);
      btn.addEventListener('mouseenter', activate);
    });

    // Landing CTA mode switcher
    const ctaModeBtns = document.querySelectorAll('.cta-mode-btn');
    const ctaForm = document.getElementById('landing-cta-form');
    const ctaLabel = document.getElementById('landing-cta-label');
    const ctaSubmit = document.getElementById('landing-cta-submit');

    ctaModeBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const mode = btn.getAttribute('data-cta-mode');
        ctaModeBtns.forEach((b) => {
          const active = b === btn;
          b.style.backgroundColor = active ? 'var(--accent)' : 'transparent';
          b.style.color = active ? 'var(--accent-ink)' : 'var(--ink)';
        });
        if (mode === 'join') {
          if (ctaForm) ctaForm.setAttribute('action', '/login');
          if (ctaLabel) ctaLabel.textContent = 'Ingresa el código de invitación de tu sala';
          if (ctaSubmit) ctaSubmit.textContent = 'Entrar y unirme a la sala';
        } else {
          if (ctaForm) ctaForm.setAttribute('action', '/register');
          if (ctaLabel) ctaLabel.textContent = 'Código de sala (opcional si te invitaron)';
          if (ctaSubmit) ctaSubmit.textContent = 'Continuar al registro y perfil';
        }
      });
    });

    // Authenticated dashboard logic: filter tabs, join room, create room
    const filterTabs = document.querySelectorAll('.room-filter-tab');
    const roomCards = document.querySelectorAll('.room-card-item');
    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        filterTabs.forEach((t) => t.classList.remove('status-pill-accent'));
        tab.classList.add('status-pill-accent');
        const filter = tab.getAttribute('data-filter') || 'all';
        roomCards.forEach((card) => {
          const status = card.getAttribute('data-room-status');
          if (filter === 'all' || status === filter) {
            card.classList.remove('hidden');
          } else {
            card.classList.add('hidden');
          }
        });
      });
    });

    const joinForm = document.getElementById('join-room-form');
    const joinError = document.getElementById('join-error');
    const joinBtn = document.getElementById('join-room-btn');
    const joinInput = document.getElementById('join-code-input');

    async function submitJoin(codeValue) {
      if (!joinError || !joinBtn) return;
      joinError.classList.add('hidden');
      joinBtn.disabled = true;
      joinBtn.textContent = 'Uniendo a la sala...';

      try {
        const res = await fetch('/api/rooms/join', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ code: codeValue }),
        });
        const data = await res.json();
        if (!res.ok) {
          joinError.textContent = data.error || 'No se pudo unir a la sala.';
          joinError.classList.remove('hidden');
          joinBtn.disabled = false;
          joinBtn.textContent = 'Entrar a la sala';
          return;
        }
        window.location.href = `/rooms/${data.room.code}`;
      } catch {
        joinError.textContent = 'Error de conexión.';
        joinError.classList.remove('hidden');
        joinBtn.disabled = false;
        joinBtn.textContent = 'Entrar a la sala';
      }
    }

    joinForm?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (joinInput?.value.trim()) {
        submitJoin(joinInput.value.trim());
      }
    });

    const urlParams = new URLSearchParams(window.location.search);
    const autoJoinCode = urlParams.get('join');
    if (autoJoinCode && joinForm) {
      submitJoin(autoJoinCode);
    }

    const createForm = document.getElementById('create-room-form');
    const createError = document.getElementById('create-error');
    const createBtn = document.getElementById('create-room-btn');

    createForm?.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (!createError || !createBtn) return;
      createError.classList.add('hidden');
      createBtn.disabled = true;
      createBtn.textContent = 'Creando sala...';

      const formData = new FormData(createForm);
      const payload = Object.fromEntries(formData.entries());

      try {
        const res = await fetch('/api/rooms/create', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const data = await res.json();
        if (!res.ok) {
          createError.textContent = data.error || 'Error al crear la sala.';
          createError.classList.remove('hidden');
          createBtn.disabled = false;
          createBtn.textContent = 'Crear sala y generar código';
          return;
        }
        window.location.href = `/rooms/${data.room.code}`;
      } catch {
        createError.textContent = 'Error de conexión.';
        createError.classList.remove('hidden');
        createBtn.disabled = false;
        createBtn.textContent = 'Crear sala y generar código';
      }
    });
  </script>
</Layout>
