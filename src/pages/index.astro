              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- SECTION 4: faq — Question index on left, answer pane on right -->
      <section id="preguntas" class="page-frame">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-start">
          <div class="lg:col-span-5 space-y-5">
            <h2 class="type-h2 reveal-item">
              Preguntas frecuentes.
            </h2>

            <div class="space-y-3 pt-2" role="tablist" aria-label="Preguntas frecuentes">
              <button
                type="button"
                data-faq-idx="0"
                class="faq-q-btn w-full text-left p-3.5 rounded-[8px] flex items-center gap-3 cursor-pointer"
                style="background-color: var(--surface); color: var(--ink); font-weight: 600;"
