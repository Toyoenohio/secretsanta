      <!-- SECTION 5: cta — First step, already open -->
      <section class="page-frame">
        <div class="field-band rounded-[14px] p-7 sm:p-12 lg:p-16 grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
          <div class="lg:col-span-6 space-y-4">
            <h2 class="type-display reveal-item" style="color: var(--field-ink);">
              Abre tu sala hoy mismo.
            </h2>
            <p class="type-body reveal-item reveal-delay-1" style="color: var(--field-muted);">
