                <span class="type-body">¿Cómo garantizan que nadie quede sin elegir o sin ser elegido?</span>
              </button>

              <button
                type="button"
                data-faq-idx="1"
                class="faq-q-btn w-full text-left p-3.5 rounded-[8px] flex items-center gap-3 cursor-pointer"
                style="background-color: transparent; color: var(--muted);"
