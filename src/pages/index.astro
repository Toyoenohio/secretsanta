---
import Layout from '../layouts/Layout.astro';
import { getCurrentUser, formatAvatarLabel } from '../lib/auth';
import { sql } from '../lib/db';

const user = await getCurrentUser(Astro.cookies);
const joinCodeParam = (Astro.url.searchParams.get('join') || '').trim().toUpperCase();

let myRooms: any[] = [];
let wishlistCount = 0;

if (user) {
  myRooms = await sql`
    SELECT
      r.id,
      r.code,
      r.name,
      r.description,
      r.exchange_date,
      r.budget_min,
      r.budget_max,
      r.currency,
      r.organizer_id,
      r.status,
      r.created_at,
      rm.has_revealed,
      rm.assigned_receiver_id,
      rec.name AS receiver_name,
      rec.nickname AS receiver_nickname,
      rec.avatar AS receiver_avatar,
      (SELECT COUNT(*)::int FROM room_members m WHERE m.room_id = r.id) AS member_count
    FROM room_members rm
    JOIN rooms r ON r.id = rm.room_id
    LEFT JOIN users rec ON rec.id = rm.assigned_receiver_id
    WHERE rm.user_id = ${user.id}
    ORDER BY r.created_at DESC
  `;

  const wCount = await sql`
    SELECT COUNT(*)::int AS total FROM wishlist_items WHERE user_id = ${user.id}
  `;
  wishlistCount = wCount[0]?.total || 0;
}

const openRoomsCount = myRooms.filter((r) => r.status === 'open').length;
const drawnRoomsCount = myRooms.filter((r) => r.status === 'drawn').length;
---

<Layout title="Sorteo cerrado y wishlist" user={user} activeTab="rooms" isLanding={!user}>
